DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://rendaerenda:rendaerenda@localhost:5432/rendaerenda

# Cache/rate-limit usam o proprio Postgres (sem Redis - custo zero extra no
# Render). True roda cache em memoria pra dev rapido (nao usar em producao:
# nao e compartilhado entre workers do gunicorn).
USE_LOCMEM_CACHE=False

# Verificacao de idade / KYC (ex.: idwall, unico, CAF).
# Preencha AGE_KYC_API_URL com o endpoint EXATO do contrato do bureau.
# Vazio = fluxo desligado: a API responde 503 e o webhook rejeita tudo.
AGE_KYC_PROVIDER=idwall
AGE_KYC_API_URL=
AGE_KYC_API_KEY=

# Bureau telefone x CPF (Serpro Datavalid, idwall...) - confirma que a linha
# pertence ao CPF antes do OTP. Em branco em dev = aprova e loga o "SMS".
PHONE_CPF_BUREAU_URL=
PHONE_CPF_BUREAU_API_KEY=
# Provider de SMS (Zenvia, Twilio, AWS SNS...)
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# NFS-e da plataforma (Focus NFe) - NF do SERVICO (comissao/assinatura),
# nunca do item. Razao social neutra = cobranca discreta no extrato.
NFSE_PROVIDER_URL=https://api.focusnfe.com.br/v2/nfse
NFSE_PROVIDER_API_KEY=
PLATFORM_LEGAL_NAME=
PLATFORM_CNPJ=
PLATFORM_MUNICIPAL_SERVICE_CODE=

# Instituicao de pagamento - Asaas (pf = pessoa fisica / pj = CNPJ com split)
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_ACCOUNT_TYPE=pf
IUGU_API_TOKEN=
IUGU_ACCOUNT_ID=

PLATFORM_COMMISSION_PERCENT=15
WALLET_RELEASE_DAYS_AFTER_SHIPPING=3

# --- Custodia (o dinheiro fica com a plataforma ate a entrega) ---
ESCROW_ENABLED=True
# Repasse imediato so vale com ESCROW_ENABLED=False.
AUTO_PAYOUT_ON_PAYMENT=False
AUTO_PAYOUT_ON_RELEASE=True
# Prazo para contestar depois de receber (dias).
DISPUTE_WINDOW_DAYS=7
# Conteudo digital libera por prazo, nao por entrega (horas).
DIGITAL_RELEASE_HOURS=24
# Teto de retencao — o valor nunca fica preso para sempre (dias).
ESCROW_MAX_HOLD_DAYS=30

# --- Checkout ---
# Tempo que o pedido segura o estoque esperando o Pix (minutos). Passado
# isso, `manage.py expire_orders` devolve o item para a vitrine.
ORDER_PAYMENT_TTL_MINUTES=60
# Validade da cobranca no Asaas (dias). Com 0 o QR vence a meia-noite.
PIX_DUE_DAYS=3
# Pix pago por CPF diferente do titular: estornar automaticamente.
REFUND_ON_PAYER_CPF_MISMATCH=True
# Soft-launch: checkout sem cotacao de frete (frete R$ 0).
CHECKOUT_FREE_SHIPPING=True

# --- Logística / frete ---
# "melhor_envio" (recomendado: multi-transportadora + pontos de coleta +
# etiqueta automática) ou "correios" (contrato CWS direto).
SHIPPING_PROVIDER=melhor_envio
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=True
# Taxa de embalagem padrão embutida no frete do comprador (nunca na vendedora).
PACKAGING_FEE=3.90
# Janela pós-entrega para o comprador confirmar/contestar antes da liberação
# automática do saldo (horas).
DELIVERY_CONFIRMATION_WINDOW_HOURS=24

# Correios (CWS) - só se SHIPPING_PROVIDER=correios
CORREIOS_CWS_USER=
CORREIOS_CWS_PASSWORD=
CORREIOS_CONTRACT_NUMBER=
CORREIOS_CARD_NUMBER=
CORREIOS_ORIGIN_CEP=

# E-mail transacional (verificacao de cadastro, recuperacao de senha) - SMTP.
# Deixe em branco em dev (usa console backend). Em producao, preencha com um
# provedor que aceite o nicho e mantenha o corpo dos e-mails sem conteudo explicito.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Renda & Renda <no-reply@rendaerenda.com.br>
# Caixa que recebe alerta de contestacao (decisao humana). Vazio = so log.
MODERATION_ALERT_EMAIL=

# Midia: por padrao disco local / disco Render (MEDIA_ROOT).
# S3 so se preencher AWS_STORAGE_BUCKET_NAME.
MEDIA_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_SIGNED_URL_EXPIRE_SECONDS=300
